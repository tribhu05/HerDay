# HerDay Environment Variables
# NEVER commit your real .env file with secrets to git!

# ElevenLabs API Key for Speech-to-Text (Scribe v2)
# Required for Voice Input transcription. Audio stays secure; requests are proxied server-side.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# MongoDB Atlas Persistence (Phase 4)
# Standard MongoDB connection string (e.g. mongodb+srv://<username>:<password>@cluster0.mongodb.net/herday?retryWrites=true&w=majority)
# Keeps credentials secure server-side. LocalStorage continues working if unconfigured.
MONGODB_URI=your_mongodb_connection_string_here

